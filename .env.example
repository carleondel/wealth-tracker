# Wealth Tracker — example environment file
# Copy to `.env.local` and fill in. `.env.local` is gitignored.

# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx   # or the legacy JWT anon key

# Finnhub free tier — used for US stock prices.
# Sign up at https://finnhub.io (30 seconds, no credit card).
# Free tier: 60 requests/min. Server-side only.
FINNHUB_API_KEY=xxx

# Optional — NVIDIA NIM hosted inference (powers the Journal tab).
# Get one for free at https://build.nvidia.com
# Server-side only; never exposed to the browser.
NVIDIA_API_KEY=nvapi-xxx
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
