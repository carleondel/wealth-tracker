# Wealth Tracker — example environment file
# Copy to `.env.local` and fill in. `.env.local` is gitignored.

# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx   # or the legacy JWT anon key

# Finnhub free tier — used for US stock prices.
# Sign up at https://finnhub.io (30 seconds, no credit card).
# Free tier: 60 requests/min. Server-side only.
FINNHUB_API_KEY=xxx


# Daily snapshot cron (optional, only on Vercel). See README → "Daily snapshot".
# Supabase → Project Settings → API → service_role (secret!). Server-side only.
SUPABASE_SERVICE_ROLE_KEY=xxx
# Any long random string; Vercel sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=xxx
